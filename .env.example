# =============================================================================
# GHOSTLINE ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env.local or set these variables in your deployment host
# =============================================================================

# --- Supabase Configuration (Client & Backend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database Repository Driver ---
# Supported options: "supabase" (default) or "neon"
DATA_REPOSITORY_DRIVER=supabase

# --- Neon Postgres Connection (if DATA_REPOSITORY_DRIVER=neon) ---
DATABASE_URL=postgres://user:password@ep-example.pooler.neon.tech/ghostline?sslmode=require

# --- Web Push Notifications (VAPID) ---
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:security@ghostline.app

# --- WebRTC Calling (TURN / STUN Credentials) ---
TURN_SECRET=your-turn-secret-key
TURN_URL=turn:turn.ghostline.app:3478

# --- Cloudflare R2 Media Storage (Attachments) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ghostline-attachments-prod
